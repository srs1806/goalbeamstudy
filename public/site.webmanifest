{
  "id": "./",
  "name": "GOALBEAM — Class 10 Study App",
  "short_name": "Goalbeam",
  "description": "Installable offline CBSE Class 10 course & board syllabus app with chapter checklists, NCERT/PYQ Vault, Pomodoro Focus Garden, and AI Study Studio.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#03050a",
  "theme_color": "#03050a",
  "categories": ["education", "productivity"],
  "icons": [
    {
      "src": "./favicon.png",
      "sizes": "48x48",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./favicon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./favicon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./pwa-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Chapters & Syllabus",
      "short_name": "Chapters",
      "url": "./chapters",
      "icons": [{ "src": "./favicon-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "3D Focus Garden",
      "short_name": "Focus",
      "url": "./focus-garden",
      "icons": [{ "src": "./favicon-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "CBSE & NCERT Vault",
      "short_name": "Resources",
      "url": "./resources",
      "icons": [{ "src": "./favicon-192x192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
